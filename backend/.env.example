DATABASE_URL=postgresql+psycopg://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require
# Comma-separated list of allowed browser origins (no trailing slash).
# e.g. FRONTEND_ORIGIN=https://algotrail.ai,https://www.algotrail.ai
FRONTEND_ORIGIN=http://localhost:3000
# REQUIRED in production: >=32 random chars. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
ENVIRONMENT=development
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# Max AI requests per user per day (cost control).
AI_DAILY_LIMIT=50
# Optional: enables Sentry error tracking when set.
SENTRY_DSN=

# Email (SMTP). Leave SMTP_HOST blank in dev to log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AlgoTrail <no-reply@algotrail.ai>
SMTP_STARTTLS=true
# Public frontend URL used to build links in emails (defaults to FRONTEND_ORIGIN).
APP_BASE_URL=http://localhost:3000

# Billing (Stripe). Leave blank in dev — billing endpoints return 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=        # Stripe Price ID for the Pro plan (price_...)
AI_PRO_DAILY_LIMIT=500
